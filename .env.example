# Copy to .env.local and fill in. Never commit .env.local. No secret may start with NEXT_PUBLIC_.
# After changing a variable in Vercel (set for Production) you must REDEPLOY.

YOUTUBE_API_KEY=            # live data; restrict to YouTube Data API v3. Missing -> demo data + banner
GEMINI_API_KEY=             # extraction/clustering/summary. Missing -> keyword fallback
GEMINI_MODEL=gemini-flash-latest   # check Google AI Studio for the current Flash model name
DATABASE_URL=               # Neon Postgres. Missing -> demo data
RESEND_API_KEY=             # email. Missing -> "Send brief" explains
RESEND_FROM=onboarding@resend.dev
BRIEF_TO_EMAIL=             # free tier only delivers to your own Resend account email
ADMIN_KEY=                  # Settings login. Missing -> settings locked
CRON_SECRET=                # protects cron routes. Missing -> 401
APP_URL=                    # links inside the email; falls back to the Vercel URL
SHOW_SPONSOR_NAMES=true     # true | false
